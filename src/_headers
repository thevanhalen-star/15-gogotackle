/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.googletagservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https://cloudflareinsights.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS는 항상 서버에 확인(ETag) — 배포 중 옛 파일이 캐시에 굳는 문제 방지
/assets/theme.css
  Cache-Control: no-cache

/assets/fonts.css
  Cache-Control: no-cache

/assets/site.js
  Cache-Control: no-cache

/assets/ads.js
  Cache-Control: no-cache

/assets/favicon.svg
  Cache-Control: public, max-age=86400

/posts/*
  Cache-Control: public, max-age=3600

/archive/*
  Cache-Control: public, max-age=600

/
  Cache-Control: public, max-age=300

/posts.json
  Cache-Control: public, max-age=600

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/tools/*
  X-Robots-Tag: noindex

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/ads-default.json
  Cache-Control: public, max-age=300
